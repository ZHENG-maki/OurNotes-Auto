<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             x:Class="MFAAvalonia.Views.Pages.GitUpdateView"
             Foreground="{DynamicResource SukiText}"
             x:CompileBindings="False">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,18,24,20" RowSpacing="18">
        <StackPanel Spacing="6">
            <TextBlock Text="Git更新" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Repository}" Opacity="0.65" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <suki:GlassCard Grid.Row="1" Padding="20,16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                <StackPanel Spacing="7" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CheckedAt}" Opacity="0.6" FontSize="12" />
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" />
                </StackPanel>
                <Button Grid.Column="1" Content="检查更新" Click="CheckUpdate"
                        IsEnabled="{Binding CanCheck}" VerticalAlignment="Center" Padding="20,10" />
            </Grid>
        </suki:GlassCard>
        <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="12">
            <TextBlock Text="最近提交" FontSize="16" FontWeight="SemiBold" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Commits}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <suki:GlassCard Padding="18,14" Margin="0,0,0,9">
                                <StackPanel Spacing="7">
                                    <TextBlock Text="{Binding Subject}" FontSize="14" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Metadata}" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                                </StackPanel>
                            </suki:GlassCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="3" Spacing="10">
            <TextBlock Text="启动时自动同步并应用更新。手动检查同步源码，重新打开程序后应用。"
                       FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
            <Expander Header="更新详情" HorizontalAlignment="Stretch" MaxHeight="180">
                <TextBox Text="{Binding Details}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         MaxHeight="130" FontSize="12" />
            </Expander>
        </StackPanel>
    </Grid>
</UserControl>
